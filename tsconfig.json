{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "node",
    "jsx": "react",
    "target": "es6",
    "module": "commonjs",
    "lib": [
      "es2021",
      "dom"
    ],
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "experimentalDecorators": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}

